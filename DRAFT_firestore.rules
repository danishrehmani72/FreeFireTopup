rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUser(data, isCreate) {
      let hasRequired = isCreate ? data.keys().hasAll(['uid', 'email', 'referralCode', 'balance', 'createdAt', 'updatedAt']) && (data.keys().size() == 6 || (data.keys().size() == 7 && data.keys().hasAll(['referredBy']))) : true;
      let types = data.uid is string && data.uid.size() <= 128
               && data.email is string && data.email.size() <= 200
               && data.referralCode is string && data.referralCode.size() <= 20
               && (isCreate ? (data.referredBy == null || (data.referredBy is string && data.referredBy.size() <= 128)) : true)
               && data.balance is number;
      let limits = isCreate ? data.balance == 0 : data.balance >= 0;
      return hasRequired && types && limits;
    }

    function isValidReferralCode(data, isCreate) {
      let hasRequired = isCreate ? data.keys().hasAll(['ownerId', 'createdAt']) && data.keys().size() == 2 : true;
      let types = data.ownerId is string && data.ownerId.size() <= 128;
      return hasRequired && types;
    }

    function isValidTransaction(data, isCreate) {
      let hasRequired = isCreate ? data.keys().hasAll(['userId', 'type', 'amount', 'status', 'createdAt']) && data.keys().size() == 5 : true;
      let types = data.userId is string && data.userId.size() <= 128
               && data.type is string && (data.type == 'purchase' || data.type == 'referral_bonus')
               && data.amount is number
               && data.status is string && (data.status == 'pending' || data.status == 'completed' || data.status == 'failed');
      return hasRequired && types;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId 
                    && isValidId(userId)
                    && isValidUser(incoming(), true)
                    && incoming().uid == request.auth.uid
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time
                    // Atomicity: they must also create their code in referralCodes
                    && existsAfter(/databases/$(database)/documents/referralCodes/$(incoming().referralCode))
                    && getAfter(/databases/$(database)/documents/referralCodes/$(incoming().referralCode)).data.ownerId == request.auth.uid;
      
      allow update: if isSignedIn() && request.auth.uid == userId
                    && isValidId(userId)
                    && isValidUser(incoming(), false)
                    && incoming().uid == existing().uid
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && incoming().referralCode == existing().referralCode
                    && (existing().referredBy == null ? true : incoming().referredBy == existing().referredBy)
                    && (incoming().balance <= existing().balance + 100000)
                    && (
                      (incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt']) && incoming().balance > existing().balance) // for topups
                    );
    }

    match /referralCodes/{codeId} {
      allow get: if isSignedIn() && isValidId(codeId);
      allow create: if isSignedIn() && isValidId(codeId)
                    && isValidReferralCode(incoming(), true)
                    && incoming().ownerId == request.auth.uid
                    && incoming().createdAt == request.time;
    }

    match /transactions/{transactionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid && resource.data.userId is string;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(transactionId)
                    && isValidTransaction(incoming(), true)
                    && incoming().userId == request.auth.uid
                    && incoming().createdAt == request.time;
    }
  }
}
